# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# ⚠️ pubspec.lock 은 **커밋한다**(앱이므로). 라이브러리면 반대다.
#    이 프로젝트는 버전 조합에 민감하다 — retrofit_generator 9.x + retrofit 4.9.x는
#    빌드가 깨지고, json_serializable 6.11은 Dart 3.8을 요구한다. lock을 빼면
#    클론한 사람이 그 지뢰를 다시 밟는다.

# 코드 생성 산출물 — build_runner로 언제든 다시 만든다.
# (팀에서 생성물을 커밋하는 정책이면 이 두 줄을 지운다.)
*.g.dart
*.freezed.dart

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Android
android/.gradle/
android/local.properties
android/key.properties
# 카카오 네이티브 앱 키 (build.gradle.kts가 읽는다). 환경변수 KAKAO_NATIVE_KEY로도 된다.
android/kakao.properties
android/app/*.jks
**/android/**/gradle-wrapper.jar

# iOS
ios/Pods/
ios/.symlinks/
# 로컬 절대경로(FLUTTER_ROOT 등)가 박혀 있다. 사람마다 다르므로 추적하지 않는다.
ios/Flutter/ephemeral/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GoogleService-Info.plist
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/xcuserdata/

# macOS
.DS_Store

# 폰트 — 라이선스상 저장소에 넣지 않는 정책이면 주석을 푼다.
# assets/fonts/*.otf
